[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="fauna"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[shader_globals]

wind={
"type": "vec4",
"value": Vector4(1, 0, 0, 0)
}
water_level={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
snow_line={
"type": "float",
"value": 1000.0
}
snow_blend={
"type": "float",
"value": 8.0
}
world_origin_offset={
"type": "vec3",
"value": Vector3(0, 0, 0)
}

[rendering]

renderer/rendering_method="forward_plus"
