[gd_resource type="Resource" script_class="MusicSettings" format=3]

[ext_resource type="Script" path="res://scripts/audio/music_settings.gd" id="1_ms"]
[ext_resource type="Script" path="res://scripts/audio/music_theme.gd" id="2_mt"]
[ext_resource type="AudioStream" path="res://assets/audio/music/music_meadow_day.ogg" id="3_day"]
[ext_resource type="AudioStream" path="res://assets/audio/music/music_meadow_dawn.ogg" id="4_dawn"]
[ext_resource type="AudioStream" path="res://assets/audio/music/music_meadow_dusk.ogg" id="5_dusk"]
[ext_resource type="AudioStream" path="res://assets/audio/music/music_meadow_night.ogg" id="6_night"]

[sub_resource type="Resource" id="Resource_meadow"]
script = ExtResource("2_mt")
biome = &"meadow"
day = ExtResource("3_day")
dawn = ExtResource("4_dawn")
dusk = ExtResource("5_dusk")
night = ExtResource("6_night")

[resource]
script = ExtResource("1_ms")
themes = Array[ExtResource("2_mt")]([SubResource("Resource_meadow")])
