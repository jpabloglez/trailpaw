[gd_resource type="Resource" script_class="HintSettings" format=3]

[ext_resource type="Script" path="res://scripts/ui/hint_settings.gd" id="1_hint"]

[resource]
script = ExtResource("1_hint")
texts = Dictionary[StringName, String]({
&"move": "{move} to explore",
&"run": "{hold_sprint} {sprint} to run",
&"sniff": "Thirsty or hungry? {sniff} to sniff around",
&"water": "Follow the blue sparkles to water",
&"eat": "Walk up to food and press {interact}",
&"map": "{map} to see where you have been",
&"rest": "Tired? {hold_rest} {rest} to rest — shade helps"
})
first_delay = 1.5
move_distance = 6.0
run_seconds = 1.5
sniff_below = 75.0
sniff_after = 90.0
eat_below = 70.0
map_after = 240.0
rest_below = 50.0
fade_per_second = 3.0
